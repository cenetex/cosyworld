      "owner": "HoppyCat",
      "runtime_fetch": false,
      "catalog_path": "v2/worlds/hoppycat/github-index.json",
      "default_ingestion": "metadata_and_link_only",
      "new_repository_policy": "review_required",
      "missing_repository_policy": "retain_tombstone",
