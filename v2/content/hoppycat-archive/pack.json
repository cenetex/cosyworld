{
  "schema_version": 1,
  "id": "hoppycat.archive",
  "name": "Hoppycat: February Third",
  "version": "0.3.0",
  "kind": "world",
  "description": "An original cosy-weird world of tea, tides, prisms, careful memory, impossible dreams, and a day trying to become tomorrow.",
  "license": "MIT",
  "license_url": "https://opensource.org/license/mit/",
  "engine": ">=0.0.20 <0.1.0",
  "capabilities": [
    {
      "id": "hoppycat.archive/world",
      "kind": "world",
      "version": "0.3.0"
    },
    {
      "id": "hoppycat.archive/assets",
      "kind": "assets",
      "version": "1.0.0"
    }
  ],
  "dependencies": [
    {
      "id": "cosyworld.rules-profile-srd5",
      "version": ">=1.0.0 <2.0.0",
      "capabilities": [
        "cosyworld.rules-profile-srd5/rules"
      ]
    }
  ],
  "default_ruleset": "cosyworld.rules-profile-srd5/rules",
  "rules_compatibility": {
    "profiles": [
      "cosyworld.srd5/1"
    ]
  },
  "entry_points": [
    {
      "kind": "location",
      "id": "location/770000"
    },
    {
      "kind": "character_creation",
      "id": "hoppycat-february-third"
    },
    {
      "kind": "asset_mount",
      "id": "cards"
    }
  ],
  "provenance": {
    "author": "CosyWorld contributors",
    "source_name": "HoppyCat public GitHub work",
    "source_url": "https://github.com/HoppyCat",
    "modification_notice": "Recurring ideas across the public repositories informed an original fantasy setting. The pack does not reproduce source text, private material, or documented Cathedral participants as characters. Original generated art uses user-provided Hoppy Cat and Teacat visual references; those references are not bundled."
  },
  "character_creation": "character_creation.json",
  "attribution": {
    "file": "ATTRIBUTION.md",
    "source_name": "HoppyCat public GitHub repositories",
    "source_url": "https://github.com/HoppyCat"
  },
  "resources": {
    "actors": "actors.json",
    "factions": "factions.json",
    "items": "items.json",
    "locations": "locations.json",
    "exits": "exits.json",
    "room_features": "room_features.json",
    "room_sheets": "room_sheets.json",
    "clocks": "clocks.json",
    "jobs": "jobs.json",
    "fronts": "fronts.json",
    "cards": "cards.json"
  },
  "assets": [
    {
      "provider": "hoppycat.archive/assets",
      "mount": "cards",
      "directory": "assets/cards",
      "public_prefix": "/assets/hoppycat/cards",
      "optional": false
    }
  ],
