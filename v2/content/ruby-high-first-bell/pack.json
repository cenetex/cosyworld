{
  "schema_version": 1,
  "id": "ruby-high.first-bell",
  "name": "Ruby High: First Bell",
  "version": "1.3.7",
  "kind": "world",
  "description": "An independently bootable public school world, card catalog, and First Bell experience.",
  "license": "MIT",
  "license_url": "https://opensource.org/license/mit",
  "engine": ">=0.0.20 <0.1.0",
  "capabilities": [
    {
      "id": "ruby-high.first-bell/world",
      "kind": "world",
      "version": "1.0.0"
    },
    {
      "id": "ruby-high.first-bell/rules",
      "kind": "rules",
      "version": "1.0.0"
    },
    {
      "id": "ruby-high.first-bell/cards",
      "kind": "cards",
      "version": "1.0.0"
    },
    {
      "id": "ruby-high.first-bell/assets",
      "kind": "assets",
      "version": "1.0.0"
    }
  ],
  "dependencies": [
    {
      "id": "cosyworld.core",
      "version": ">=1.3.0 <2.0.0",
      "capabilities": [
        "cosyworld.core/world"
      ],
      "optional": true
    },
    {
      "id": "cosyworld.rules-profile-srd5",
      "version": ">=1.0.0 <2.0.0",
      "capabilities": [
        "cosyworld.rules-profile-srd5/rules"
      ]
    }
  ],
  "rules_profile": "cosyworld.srd5/1",
  "entry_points": [
    {
      "kind": "location",
      "id": "location/11"
    },
    {
      "kind": "card_catalog",
      "id": "first-bell"
    },
    {
      "kind": "asset_mount",
      "id": "cards"
    }
  ],
  "provenance": {
    "author": "Ruby High",
    "source_name": "Ruby High: First Bell",
    "source_url": "https://ruby-high.ai"
  },
  "distribution": {
    "media_type": "application/vnd.cosyworld.pack+json",
    "canonicalization": "jcs",
    "permanence": "content-addressed"
  },
  "resources": {
    "actor_facets": "actor_facets.json",
    "factions": "factions.json",
    "locations": "locations.json",
    "exits": "exits.json",
    "room_features": "room_features.json",
    "room_sheets": "room_sheets.json",
    "action_vocabulary": "action_vocabulary.json",
    "cards": "cards.json",
    "card_bindings": "card_bindings.json",
    "sentences": "sentences.json"
  },
  "contributions": {
    "reskins": "reskins.json",
    "offers": "offers.json"
  },
  "external_cards": "external_cards.json",
  "assets": [
    {
      "provider": "ruby-high.first-bell/assets",
      "mount": "cards",
      "directory": "assets/cards",
      "public_prefix": "/assets/cards",
      "optional": true,
      "fallback": "external_uri"
    }
  ],
  "default_ruleset": "ruby-high.first-bell/rules",
  "extensions": {
    "x-cosyworld-rules-context": {
      "schema_version": 1,
      "zones": [
        {
          "zone": "sanctuary",
          "ruleset": "ruby-high.first-bell/rules"
        }
      ],
      "vocabulary": {
        "actions": [
          "study",
          "test",
          "revise",
          "attend"
        ],
        "narration": [
          "first bell",
          "hall pass",
          "evidence",
          "homeroom"
        ]
      }
    }
  }
}
