    "x-cosyworld-media": {
      "schema_version": 1,
      "profiles": [
        {
          "profile": "project89.world-art.base/1",
          "operations": ["base_generation"],
          "intents": ["location_card_art"],
          "reference_slots": [],
          "maximum_references": 0
        },
        {
          "profile": "project89.world-art.refinement/1",
          "operations": ["single_reference", "multi_reference"],
          "intents": ["location_card_art", "room_scene"],
          "reference_slots": ["location", "style"],
          "maximum_references": 2
        }
      ]
    },
    "x-cosyworld-generation": {
      "schema_version": 1,
      "policy_id": "project89.open-signal-frontier/generation/1",
      "migration_version": 1,
      "collision_namespace": "pack://project89.open-signal-frontier/generated/v1",
      "generated_descendants": {
        "owner": "source_route",
        "composition": "active_bundle",
        "subject_kinds": ["route", "waypoint", "place", "location_card"],
        "on_upgrade": "require_declared_migration",
        "on_unmount": "freeze_with_owner"
      },
      "place_anchor": {
        "action_label": "Scan the sector",
        "target_label": "a Signal Anchor",
        "question": "Can someone scan and register this frontier sector?",
        "description": "Calibrate a durable public Signal Anchor beside one locally significant landmark so the station network can recognize the place.",
        "completion_memory": "A Signal Anchor now registers this frontier place.",
        "visual_description": "A durable human-scaled signal fixture with a low teal frame and coral calibration lights beside one locally significant frontier landmark, weathered to match the setting; no writing, logo, interface text, people, or portable form."
      },
      "prose": {
        "profile_id": "cosyworld.pathway-prose.ecology/1",
        "prompt_versions": ["pathway-content-v2"],
        "ecology": {
          "interpolation": "endpoint_blend/1",
          "required_context": [
            "route_id",
            "route_version",
            "origin",
            "destination",
            "travel_direction",
            "segment_index",
            "segment_count",
            "biome",
            "terrain",
            "climate",
            "landforms",
            "geology",
            "hydrology",
            "vegetation",
            "fauna",
            "resource_cues",
            "nearby_authored_descriptions"
          ]
        }
      },
      "media": {
        "profile_id": "project89.world-art.base/1",
        "recipe_id": "replicate.ratimics-project89.v95f3d0eb",
        "provider_preference": {
          "provider": "replicate",
          "model": "ratimics/project89",
          "revision": "95f3d0eb7bdceb1262a2824c1a623e01b1902b71420013e6bc7b760e9f9255d6"
        },
        "prompt_version": "project89-art/2",
        "prompt_prefix": "P89, anime style,",
        "aspect_ratios": ["16:9"],
        "output_formats": ["webp"],
        "negative_constraints": ["no text", "no logos", "no interface chrome"],
        "subject_kinds": ["location_card"],
        "authored_art": "permanent",
        "community_art": "eligible",
        "unexplored_placeholder": "common_unexplored/1",
        "fallback": "unexplored_placeholder"
      },
      "topology": {
        "profile_id": "open_frontier",
        "directionality": "reciprocal_or_explicit_one_way",
        "evacuation": "world_lifecycle_required",
        "budgets": {
          "components": { "min": 1, "max": 1 },
          "roots": { "min": 4, "max": 4 },
          "ingress": { "min": 4, "max": 4 },
          "egress": { "min": 4, "max": 4 },
          "weighted_distance": { "min": 178, "max": 178 },
          "degree": { "min": 2, "max": 2 },
          "cycle_rank": { "min": 1, "max": 1 },
          "bridges": { "min": 0, "max": 0 },
          "articulation_impact": { "min": 0, "max": 0 },
          "terminal_spurs": { "min": 0, "max": 0 }
        }
      },
      "migrations": [
        {
          "from_policy_id": "project89.open-signal-frontier/generation/1",
          "from_migration_version": 1,
          "from_pack_version": "0.1.0",
          "mode": "preserve_descendants"
        }
      ],
      "cross_pack_routes": []
    },
    "x-project89-frontier": {
      "schema_version": 1,
      "authored_station_count": 4,
      "executable_trunk_distance": 89,
