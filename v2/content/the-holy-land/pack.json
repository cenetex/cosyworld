{
  "schema_version": 1,
  "id": "cosyworld.the-holy-land",
  "name": "The Holy Land",
  "version": "1.1.6",
  "kind": "world",
  "description": "A watercolor pilgrimage through Gospel-associated places with the Twelve and generative wayside supplicants; Jesus is not depicted as an actor or collectible card.",
  "license": "MIT",
  "license_url": "https://opensource.org/license/mit",
  "engine": ">=0.0.20 <0.1.0",
  "capabilities": [
    {
      "id": "cosyworld.the-holy-land/world",
      "kind": "world",
      "version": "1.0.0"
    },
    {
      "id": "cosyworld.the-holy-land/assets",
      "kind": "assets",
      "version": "1.0.0"
    }
  ],
  "dependencies": [
    {
      "id": "cosyworld.core",
      "version": ">=1.0.0 <2.0.0",
      "capabilities": [
        "cosyworld.core/world"
      ]
    },
    {
      "id": "cosyworld.rules-profile-srd5",
      "version": ">=1.0.0 <2.0.0",
      "capabilities": [
        "cosyworld.rules-profile-srd5/rules"
      ]
    }
  ],
  "rules_profile": "cosyworld.srd5/1",
  "default_ruleset": null,
  "entry_points": [
    {
      "kind": "location",
      "id": "location/700"
    },
    {
      "kind": "asset_mount",
      "id": "cards"
    }
  ],
  "provenance": {
    "author": "Cenetex",
    "source_name": "CosyWorld: The Holy Land",
    "source_url": "https://github.com/cenetex/cosyworld"
  },
  "resources": {
    "actors": "actors.json",
    "locations": "locations.json",
    "exits": "exits.json",
    "room_features": "room_features.json",
    "room_sheets": "room_sheets.json",
    "cards": "cards.json"
  },
  "assets": [
    {
      "provider": "cosyworld.the-holy-land/assets",
      "mount": "cards",
      "directory": "assets/cards",
      "public_prefix": "/assets/the-holy-land/cards",
      "optional": false
    }
  ],
  "extensions": {
    "x-cosyworld-generation": {
      "schema_version": 1,
      "policy_id": "cosyworld.the-holy-land/generation/1",
      "migration_version": 2,
      "collision_namespace": "pack://cosyworld.the-holy-land/generated/v1",
      "generated_descendants": {
        "owner": "source_route",
        "composition": "active_bundle",
        "subject_kinds": ["route", "waypoint", "place", "location_card"],
        "on_upgrade": "require_declared_migration",
        "on_unmount": "freeze_with_owner"
      },
      "place_anchor": {
        "action_label": "Build a cairn",
        "target_label": "a cairn",
        "question": "Can someone build a cairn here?",
        "description": "Stack local stones into a durable trail marker that future travelers can inspect.",
        "completion_memory": "A cairn now marks this place for future travelers.",
        "visual_description": "A small hand-built cairn of weathered local fieldstones, stable and human-scaled, using the same geology and watercolor palette as its surroundings; no writing, symbols, plaque, people, logo, or modern material."
      },
      "prose": {
        "profile_id": "cosyworld.pathway-prose.ecology/1",
        "prompt_versions": ["pathway-content-v1"],
        "ecology": {
          "interpolation": "endpoint_blend/1",
          "required_context": [
            "route_id",
            "route_version",
            "origin",
            "destination",
            "travel_direction",
            "segment_index",
            "segment_count",
            "biome",
            "terrain",
            "climate",
            "landforms",
            "geology",
            "hydrology",
            "vegetation",
            "fauna",
            "resource_cues",
            "nearby_authored_descriptions"
          ]
        }
      },
      "media": {
        "profile_id": "cosyworld.holy-land.generated-landscape/1",
        "recipe_id": "replicate.holy-land-b43l.base",
        "provider_preference": {
          "provider": "replicate",
          "model": "ratimics/b43l",
          "revision": "2846199bda89a44676dc5da00bd02faa3f5183b1c1d3e124c966d656874f141f"
        },
        "prompt_version": "holy-land-location/1",
        "prompt_prefix": "B43L, watercolor pilgrimage landscape, historically grounded Levantine ecology",
        "aspect_ratios": ["16:9"],
        "output_formats": ["webp"],
        "negative_constraints": ["no text", "no logos", "no depiction of Jesus"],
        "subject_kinds": ["location_card"],
        "authored_art": "permanent",
        "community_art": "eligible",
        "unexplored_placeholder": "common_unexplored/1",
        "fallback": "unexplored_placeholder"
      },
      "topology": {
        "profile_id": "regional_mesh",
        "directionality": "reciprocal_or_explicit_one_way",
        "evacuation": "world_lifecycle_required",
        "budgets": {
          "components": { "min": 1, "max": 1 },
          "roots": { "min": 1, "max": 2 },
          "ingress": { "min": 1, "max": 3 },
          "egress": { "min": 1, "max": 3 },
          "weighted_distance": { "min": 20, "max": 32 },
          "degree": { "min": 3, "max": 5 },
          "cycle_rank": { "min": 1, "max": 4 },
          "bridges": { "min": 8, "max": 12 },
          "articulation_impact": { "min": 3, "max": 8 },
          "terminal_spurs": { "min": 3, "max": 6 }
        }
      },
      "migrations": [
        {
          "from_policy_id": "cosyworld.the-holy-land/generation/1",
          "from_migration_version": 1,
          "from_pack_version": "1.1.4",
          "mode": "preserve_descendants"
        },
        {
          "from_policy_id": "cosyworld.compatibility.host-generation/1",
          "from_migration_version": 0,
          "from_pack_version": "1.1.3",
          "mode": "preserve_descendants"
        }
      ],
      "cross_pack_routes": []
    }
  }
}
