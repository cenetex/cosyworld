    "actors": "actors.json",
    "factions": "factions.json",
    "items": "items.json",
    "locations": "locations.json",
    "exits": "exits.json",
    "hidden_exits": "hidden_exits.json",
    "room_features": "room_features.json",
    "room_sheets": "room_sheets.json",
    "clocks": "clocks.json",
    "jobs": "jobs.json",
    "action_vocabulary": "action_vocabulary.json",
    "fronts": "fronts.json",
    "cards": "cards.json",
    "lifecycle_hooks": "lifecycle_hooks.json",
    "evolution_tracks": "evolution_tracks.json",
    "recipes": "recipes.json",
    "sentences": "sentences.json"
  },
  "contributions": {
    "offers": "offers.json"
  },
  "extensions": {
    "x-cosyworld-building-archetypes": {
      "schema_version": 1,
      "footprint_class": "major",
      "construction": {
        "segments": 4,
        "strategies": ["work", "help", "prepare"]
      },
      "upgrade": {
        "segments": 3,
        "strategies": ["work", "help"]
      },
      "archetypes": [
        {
          "id": "dwelling",
          "name": "Cosy Cottage",
          "description": "A shared home whose completed hearth can make this place safe and hospitable.",
          "classification": "universal",
          "capabilities": ["sanctuary", "rest", "hosting", "bonds", "resident_arrivals", "stewardship"],
          "upgrade_capabilities": ["knowledge_traces"],
          "quest_templates": ["stewardship.cottage"],
          "recipe_tags": ["cottage"],
          "cache_policy": "none"
        },
        {
          "id": "waystation",
          "name": "Waystation",
          "description": "A public stopping place for represented deliveries, routes, and travelers.",
          "classification": "universal",
          "capabilities": ["route_support", "delivery_needs", "traveler_arrivals", "stewardship"],
          "upgrade_capabilities": ["signals"],
          "quest_templates": ["service.waystation"],
          "recipe_tags": [],
          "cache_policy": "none"
        },
        {
          "id": "workshop",
          "name": "Workshop",
          "description": "A work room that exposes only declared transformations and repairs.",
          "classification": "universal",
