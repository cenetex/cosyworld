[
  {
    "hook": "on_clock_fill",
    "target_kind": "clock",
    "target_id": "lantern-keeper.light",
    "claim_scope": "event_once",
    "effects": [
      { "op": "set_tag", "tag_id": "room:804:beacon_rekindled", "scope": "room", "scope_id": 804, "label": "beacon rekindled", "kind": "memory", "reason": "lantern_keeper_completed" },
      { "op": "set_job_status", "job_id": "lantern-keeper:rekindle-the-beacon", "status": "completed", "reason": "lantern_keeper_completed" }
