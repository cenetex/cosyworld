{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cosyworld.dev/schemas/discovery-authority-v1.schema.json",
  "title": "CosyWorld Discovery Authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_version",
    "roll_algorithm",
    "stocking_tables",
    "event_tables",
    "presentation_tables",
    "slots"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_version": { "const": "discovery-receipt-v1" },
    "roll_algorithm": { "const": "weighted-fnv1a-v1" },
    "stocking_tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/stockingTable" }
    },
    "event_tables": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/eventTable" }
    },
    "presentation_tables": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/presentationTable" }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9-]*/[a-z][a-z0-9._/-]*$"
    },
    "rowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "targetKind": {
      "enum": ["item", "feature", "actor", "route", "location", "resource", "lore"]
    },
    "eligibleInputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "slot_id" } },
        { "contains": { "const": "slot_version" } }
      ],
      "items": {
        "enum": [
          "world_seed",
          "worldpack_bundle_hash",
          "slot_id",
          "slot_version",
          "origin_id",
          "region_id",
          "rules_profile",
          "claim_scope_id"
        ]
      }
    },
    "resultIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/canonicalId" }
    },
    "stockingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "result_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/rowId" },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "result_ids": { "$ref": "#/$defs/resultIds" },
        "unique": { "type": "boolean" },
        "topology_entity_ids": { "$ref": "#/$defs/resultIds" }
      }
    },
    "stockingTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "target_kind",
        "eligible_inputs",
        "rows",
        "fallback_row_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:discovery-table/[a-z][a-z0-9-]*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "target_kind": { "$ref": "#/$defs/targetKind" },
        "eligible_inputs": { "$ref": "#/$defs/eligibleInputs" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stockingRow" }
        },
        "fallback_row_id": { "$ref": "#/$defs/rowId" }
      }
    },
    "eventRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "effect_kind", "target_id", "amount"],
      "properties": {
        "id": { "$ref": "#/$defs/rowId" },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "effect_kind": {
          "enum": [
            "advance_pressure",
            "alter_lead",
            "change_position",
            "consume_resource",
            "change_hazard",
            "change_method"
          ]
        },
        "target_id": { "$ref": "#/$defs/canonicalId" },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "eventTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "eligible_inputs", "rows"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:event-table/[a-z][a-z0-9-]*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "eligible_inputs": { "$ref": "#/$defs/eligibleInputs" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/eventRow" }
        }
      }
    },
    "presentationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/rowId" },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presentationTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "rows"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:presentation-table/[a-z][a-z0-9-]*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/presentationRow" }
        }
      }
    },
    "tell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sense", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/rowId" },
        "sense": {
          "enum": ["sight", "sound", "smell", "touch", "taste", "other"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixedStocking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "result_ids"],
      "properties": {
        "kind": { "const": "fixed" },
        "result_ids": { "$ref": "#/$defs/resultIds" }
      }
    },
    "tableStocking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "table_id", "table_version"],
      "properties": {
        "kind": { "const": "table" },
        "table_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:discovery-table/[a-z][a-z0-9-]*$"
        },
        "table_version": { "$ref": "#/$defs/version" }
      }
    },
    "optionalProgression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "optional" }
      }
    },
    "requiredProgression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sign_budget", "fallback_row_id"],
      "properties": {
        "kind": { "const": "required" },
        "sign_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "fallback_row_id": { "$ref": "#/$defs/rowId" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "target_kind",
        "origin_id",
        "scope",
        "initial_phase",
        "tells",
        "reveal_methods",
        "claim_policy",
        "stocking",
        "progression"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:discovery/[a-z][a-z0-9-]*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "target_kind": { "$ref": "#/$defs/targetKind" },
        "origin_id": { "$ref": "#/$defs/canonicalId" },
        "scope": { "enum": ["actor", "expedition", "world"] },
        "initial_phase": { "enum": ["latent", "signed"] },
        "tells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tell" }
        },
        "reveal_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["notice", "search", "study", "scout"] }
        },
        "claim_policy": { "const": "once_per_scope" },
        "stocking": {
          "oneOf": [
            { "$ref": "#/$defs/fixedStocking" },
            { "$ref": "#/$defs/tableStocking" }
          ]
        },
        "authorized_topology_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalId" }
        },
        "gate_id": { "$ref": "#/$defs/canonicalId" },
        "hazard_id": { "$ref": "#/$defs/canonicalId" },
        "event_table_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:event-table/[a-z][a-z0-9-]*$"
        },
        "event_table_version": { "$ref": "#/$defs/version" },
        "presentation_table_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*:presentation-table/[a-z][a-z0-9-]*$"
        },
        "presentation_table_version": { "$ref": "#/$defs/version" },
        "progression": {
          "oneOf": [
            { "$ref": "#/$defs/optionalProgression" },
            { "$ref": "#/$defs/requiredProgression" }
          ]
        }
      }
    }
  }
}
