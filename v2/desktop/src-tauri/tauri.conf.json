{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CosyWorld",
  "version": "../../../package.json",
  "identifier": "chat.rati.cosyworld",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CosyWorld",
        "width": 650,
        "height": 680,
        "minWidth": 390,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../bundle/game/": "game/",
      "../bundle/voice/": "voice/",
      "../bundle/voices/": "voices/"
    },
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "shortDescription": "A local card world with character voices",
    "category": "Game",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
