{
  "about": "Browser smokes for the fast check (.github/workflows/fast-check.yml), chosen in scripts/select-fast-smokes.mjs. The core smokes run on every pull request and main push, each in its own parallel job, so a core journey cannot go red unnoticed. A changed smoke script runs next, then the rules below in order, up to max more; a core smoke a rule names runs once and takes no slot. Each smoke serves the static card game; smokes in needsRust start the Rust server and run only in the full suite (ci.yml).",
  "max": 3,
  "core": [
    "smoke-card-boot",
    "smoke-card-image-first",
    "smoke-card-actions",
    "smoke-card-beat-stack",
    "smoke-card-unveil",
    "check-card-awakening"
  ],
  "needsRust": [
    "smoke-card-local",
    "smoke-shared-cards",
    "smoke-card-greek-capacity",
    "smoke-card-narrative-contract"
  ],
  "rules": [
    {
      "paths": "^v2/card-game/(beats|combat-beats|dialogue|character-speech|narrative)\\.",
      "smokes": ["smoke-card-beat-stack", "smoke-card-dialogue-timing"]
    },
    {
      "paths": "^v2/card-game/(combat|defeat-view)",
      "smokes": ["smoke-card-combat"]
    },
    {
      "paths": "^v2/card-game/card-(exit|ghost|swap|entry)\\.",
      "smokes": ["smoke-card-swap", "smoke-card-exit", "smoke-card-beat-stack"]
    },
    {
      "paths": "^v2/card-game/(card-tiers|cards|rarity|images)\\.|covered",
      "smokes": ["smoke-card-unveil", "smoke-card-actions"]
    },
    {
      "paths": "^v2/card-game/(world|pack-rules|roaming-routes|want|want-talk|motives|life)\\.mjs|^v2/card-game/rules/",
      "smokes": ["smoke-card-actions", "smoke-card-pond-access"]
    },
    {
      "paths": "^v2/card-game/shared|^v2/orchestrator-rust/|^v2/core-c/",
      "smokes": ["smoke-shared-play-status", "smoke-shared-snapshot-order"]
    },
    {
      "paths": "^v2/card-game/(music|hum|opening)|music-streams|^v2/scripts/(music-reveal-check|shared-music-openings)\\.",
      "smokes": ["smoke-card-music"]
    },
    {
      "paths": "^v2/card-game/credits",
      "smokes": ["smoke-card-credits"]
    },
    {
      "paths": "^v2/card-game/(weather|stage-light)",
      "smokes": ["smoke-card-weather"]
    },
    {
      "paths": "^v2/card-game/(title-intro|entry)\\.",
      "smokes": ["smoke-card-title-intro"]
    },
    {
      "paths": "^v2/card-game/title-logo|^v2/card-game/assets/title/",
      "smokes": ["smoke-card-toolbar-logo"]
    },
    {
      "paths": "^v2/card-game/toolbar",
      "smokes": ["smoke-card-toolbar", "smoke-card-world-menu"]
    },
    {
      "paths": "^v2/card-game/(avatar-menu|avatar-world|unlock-view)",
      "smokes": [
        "smoke-card-world-menu",
        "smoke-card-world-slots",
        "smoke-card-find-hidden"
      ]
    },
    {
      "paths": "^v2/card-game/settings-",
      "smokes": ["smoke-card-settings"]
    },
    {
      "paths": "^v2/card-game/(privacy|shared-auth)",
      "smokes": ["smoke-card-privacy"]
    },
    {
      "paths": "^v2/card-game/metrics",
      "smokes": ["smoke-card-play-counts"]
    }
  ],
  "rust": {
    "about": "The fast check's Rust job (scripts/select-rust-tests.mjs). It runs when a change touches the crate, a file the crate's sources name (include_str!, include_bytes!, a file or directory a test reads, a module a test imports through Node), or a path below. Each touched module or input adds the test filter of the modules that own or read it; crate-wide files (main.rs, build.rs, Cargo files, fixtures only main.rs reads) and paths with no rule add default. A parent module's filter covers its children; at most max filters run. ignoreInputs lists named inputs a fast check already covers.",
    "paths": "^v2/(orchestrator-rust|ai-model-rust|core-c)/|^v2/scripts/check-rust\\.sh$",
    "max": 6,
    "default": ["card_shared.rs", "card_narrative.rs"],
    "ignoreInputs": ["package.json"],
    "rules": [
      {
        "about": "The C kernel and card session guards.",
        "paths": "^v2/core-c/",
        "modules": ["card_shared.rs", "kernel.rs"]
      },
      {
        "about": "build.rs embeds the public card files this script lists.",
        "paths": "^v2/scripts/build-card-assets\\.mjs$|^v2/card-game/public-assets\\.mjs$",
        "modules": ["card_game.rs"]
      }
    ]
  }
}
