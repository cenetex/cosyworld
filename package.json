{
  "name": "cosyworld",
  "version": "1.2.127",
  "description": "A persistent card world with local and shared play",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run v2:start",
    "dev:game": "npm run v2:start",
    "check": "npm test && npm run v2:worldpack && npm run v2:rust:test && npm run v2:architecture && npm run v2:syntax",
    "check:local": "npm run check:ui && npm run check:test-guards && npm test && npm run v2:check",
    "check:test-guards": "node scripts/check-test-skips.mjs && node scripts/check-recorded-saves.mjs",
    "check:ui": "node scripts/check-ui-inventory.mjs",
    "check:comments": "node scripts/check-comment-ratchet.mjs",
    "deploy:timings": "node scripts/deploy-timings.mjs",
    "v2:start": "./v2/mvp.sh start",
    "v2:restart": "./v2/mvp.sh restart",
    "v2:status": "./v2/mvp.sh status",
    "v2:smoke:deploy-readiness": "node v2/scripts/smoke-deployed-readiness.mjs",
    "v2:check": "./v2/mvp.sh check",
    "v2:stop": "./v2/mvp.sh stop",
    "v2:worldpack": "npm run v2:card:pack:check && npm run v2:worldpack:hoppycat",
    "v2:worldpack:hoppycat": "node --test v2/scripts/hoppycat-source-index.test.mjs && node v2/scripts/hoppycat-source-index.mjs --validate",
    "v2:hoppycat:index:sync": "node v2/scripts/hoppycat-source-index.mjs --write",
    "v2:hoppycat:index:check": "node v2/scripts/hoppycat-source-index.mjs --check",
    "v2:hoppycat:index:validate": "node v2/scripts/hoppycat-source-index.mjs --validate",
    "v2:ai-model:test": "cargo test --manifest-path v2/ai-model-rust/Cargo.toml",
    "v2:ai-model:wasm": "cargo build --manifest-path v2/ai-model-rust/Cargo.toml --target wasm32-unknown-unknown --release",
    "v2:rust:test": "bash ./v2/scripts/check-rust.sh test",
    "v2:voice:eval": "cd v2/orchestrator-rust && cargo test --bin cosyworld-orchestrator narrative::voice_eval -- --nocapture",
    "v2:rust:build": "bash ./v2/scripts/check-rust.sh build",
    "v2:architecture": "bash ./v2/scripts/check-main-size.sh && bash ./v2/scripts/check-rust-lint.sh",
    "v2:syntax": "node --check v2/scripts/hoppycat-source-index.mjs && node --check v2/scripts/smoke-deployed-readiness.mjs && node --check v2/scripts/check-storage-budget.mjs && node --check v2/scripts/check-fly-oom.mjs && node --check scripts/bump-version.mjs && node --check scripts/check-version-bump.mjs && python3 -m unittest discover -s v2/scripts -p test_speech_contract_evaluation.py && node --check v2/scripts/build-card-worldpacks.mjs && node --check v2/scripts/smoke-card-greek-drama.mjs",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test:journeys:build": "node v2/scripts/build-test-journeys.mjs --write",
    "test:journeys:check": "node v2/scripts/build-test-journeys.mjs --check",
    "check:version": "node scripts/check-version-bump.mjs",
    "land": "node scripts/land-branch.mjs",
    "regen": "node scripts/regen.mjs",
    "regen:check": "node scripts/regen.mjs --check",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "play:cards": "node v2/card-game/serve.mjs",
    "v2:card:unveil:smoke": "node v2/scripts/smoke-card-unveil.mjs",
    "v2:card:quest:smoke": "node v2/scripts/smoke-card-quest.mjs",
    "v2:card:pack:build": "node v2/scripts/build-card-worldpacks.mjs && npm run v2:card:images:build && npm run v2:card:music:build && npm run v2:card:assets:build && npm run v2:card:shared:build && npm run v2:card:narrator:build && npm run v2:card:content:build && npm run v2:card:authored:build",
    "v2:card:pack:check": "node v2/scripts/build-card-worldpacks.mjs --check && npm run test:journeys:check && npm run v2:card:images:check && npm run v2:card:music:check && npm run v2:card:assets:check && npm run v2:card:shared:check && npm run v2:card:narrator:check && npm run v2:card:content:check && npm run v2:card:authored:check",
    "v2:card:greek:smoke": "node v2/scripts/smoke-card-greek-drama.mjs",
    "v2:card:assets:build": "node v2/scripts/build-card-assets.mjs",
    "v2:card:assets:check": "node v2/scripts/build-card-assets.mjs --check",
    "v2:card:shared:build": "node v2/scripts/build-card-shared-engine.mjs",
    "v2:card:shared:check": "node v2/scripts/build-card-shared-engine.mjs --check",
    "v2:card:shared:next": "node v2/scripts/next-shared-rules.mjs && node v2/scripts/build-card-shared-narrator.mjs && node v2/scripts/build-card-shared-content.mjs && npm run v2:card:assets:build",
    "v2:card:narrator:build": "node v2/scripts/build-card-shared-narrator.mjs",
    "v2:card:narrator:check": "node v2/scripts/build-card-shared-narrator.mjs --check",
    "v2:card:content:build": "node v2/scripts/build-card-shared-content.mjs",
    "v2:card:content:check": "node v2/scripts/build-card-shared-content.mjs --check",
    "v2:card:authored:build": "node v2/scripts/build-card-authored-text.mjs",
    "v2:card:authored:check": "node v2/scripts/build-card-authored-text.mjs --check",
    "play:cards:local": "bash v2/scripts/play-cards-local.sh",
    "local:test": "python3 -m unittest discover -s v2/local -p \"test_*.py\"",
    "desktop:build": "python3 v2/desktop/build.py",
    "v2:card:images:build": "node v2/scripts/build-card-images.mjs",
    "v2:card:images:check": "node v2/scripts/build-card-images.mjs --check",
    "v2:card:ship-art:build": "node v2/scripts/build-ship-artpack.mjs",
    "v2:card:ship-art:check": "node v2/scripts/build-ship-artpack.mjs --check",
    "v2:card:music:build": "node v2/scripts/build-card-music.mjs && node v2/scripts/build-card-radio.mjs",
    "v2:card:music:check": "node v2/scripts/build-card-music.mjs --check && node v2/scripts/build-card-radio.mjs --check",
    "v2:card:travel:smoke": "node v2/scripts/smoke-card-greek-travel.mjs"
  },
  "keywords": [
    "ai",
    "mud",
    "rpg",
    "rust",
    "persistent-world",
    "procedural-generation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cenetex/cosyworld.git"
  },
  "author": "Jon Beckwith",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "replicate": "^1.0.1",
    "sharp": "^0.35.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "esbuild": "0.25.11",
    "eslint": "^9.24.0",
    "playwright": "1.61.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.4"
  }
}
